# Ghostty config — ported from kitty.conf (2026-07-27)
# Reload without restart: Cmd+Shift+, (or `ghostty +show-config` to inspect)
# Docs: https://ghostty.org/docs/config
# Only settings that differ from Ghostty defaults are included.

# --- Startup ---
# Kitty's startup.session did `cd ~/Developer; launch zsh`.
# Ghostty has no session file; zsh is your login shell already, so we just set the cwd.
working-directory = /Users/hernangonzalez/Developer
# Don't restore windows/tabs after a restart — Ghostty now runs resident and
# launches windowless, so restored windows would fight that.
window-save-state = never

# --- Fonts ---
font-family = FiraCode Nerd Font Mono
font-size = 12
# NOTE: no equivalent for kitty's `disable_ligatures cursor` (ligatures only under
# the cursor). Ligatures are on by default. To kill them entirely, uncomment:
# font-feature = -calt, -liga, -dlig

# --- Cursor ---
cursor-style = bar
cursor-style-blink = false

# --- Mouse ---
copy-on-select = clipboard

# --- Window ---
# kitty window_padding_width was `8 8 8 16` (top right bottom left).
window-padding-x = 16,8
window-padding-y = 8,8
confirm-close-surface = false

# --- Theme (Nightfox) ---
# Built-in theme is identical to your nightfox.conf palette 0-15 + bg/fg/cursor/selection.
theme = Nightfox
# Extended colors 16/17 from your kitty theme:
palette = 16=#f4a261
palette = 17=#d67ad2

# Blurred/transparent variant (was nightfox-blurred.conf):
background-opacity = 0.89
background-blur = 10

# --- Quick terminal (quake-style drop-down panel) ---
# Global keybind works even when Ghostty isn't focused. macOS will ask for
# Accessibility permission the first time (System Settings > Privacy & Security
# > Accessibility > Ghostty).
keybind = global:cmd+shift+enter=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0.15
# Hide the panel when it loses focus (comment out to keep it pinned).
quick-terminal-autohide = true

# --- macOS ---
macos-option-as-alt = true
# Stay resident so the global quick-terminal hotkey keeps working after every
# window is closed. Ghostty's default; we were overriding it before.
quit-after-last-window-closed = false
# Launch into the background at login — no window until the hotkey is pressed.
initial-window = false
# Keep the Dock icon and Cmd-Tab entry. `always` hides both, which suits a
# panel-only setup, but makes regular windows (Cmd+N from the panel)
# unreachable once you click away from them.
macos-hidden = never
# Transparent titlebar lets the blur/transparency extend behind it
# (closest to kitty's `macos_titlebar_color background`).
macos-titlebar-style = transparent
